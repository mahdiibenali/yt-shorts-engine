# --- REQUIRED ---
PEXELS_API_KEY=your_pexels_api_key_here

# --- CONTENT ---
# Reddit (optional - one content source)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=yt-shorts-engine/1.0

# AI Script Generation (100% Free Providers - Auto-Fallback Order: Ollama -> g4f -> 9Router -> Template)
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
G4F_MODEL=gpt-4o-mini
NINE_ROUTER_URL=http://localhost:20128/v1
OPENAI_API_KEY=


# --- YOUTUBE UPLOAD ---
# OAuth 2.0 credentials from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# --- SYSTEM ---
LOG_LEVEL=info
PORT=8000
DATA_DIR=./data
CONCURRENCY=1
TEMP_DIR=./data/temp

# --- CURIOSITY INTELLIGENCE ---
CURIOSITY_DB_PATH=./data/curiosity.db
BELIEF_AUTO_APPROVE_AFTER_DAYS=2
PREDICTION_METRIC=retention
